# URL công khai của site (bắt buộc khi build: canonical, og:url, JSON-LD, sitemap, robots).
# Phải trùng basePath trong lib/site-paths.ts (hiện là gốc tên miền). Trên Vercel: đặt trong Project Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://ketoanngochoang.com.vn/

# URL Google Apps Script Web App nhận biểu mẫu tư vấn (xem docs/google-apps-script/README.md).
# Để trống → biểu mẫu chạy chế độ trình diễn, không gửi dữ liệu.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
